# Copie para deploy/.env na VM e preencha. Nunca commitar o .env.

# Domínio da API (DuckDNS) e endereço público do frontend (Vercel)
DOMINIO_API=investai-tcc.duckdns.org
FRONTEND_URL=https://investai-tcc.vercel.app

# PostgreSQL (gere senhas fortes: openssl rand -hex 24)
POSTGRES_DB=investai
POSTGRES_USER=investai
POSTGRES_PASSWORD=troque_essa_senha
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/investai
SPRING_DATASOURCE_USERNAME=investai
SPRING_DATASOURCE_PASSWORD=troque_essa_senha

# RabbitMQ (o usuário guest não aceita conexão de fora do próprio container)
SPRING_RABBITMQ_HOST=rabbitmq
SPRING_RABBITMQ_USERNAME=investai
SPRING_RABBITMQ_PASSWORD=troque_essa_senha
RABBITMQ_URL=amqp://investai:troque_essa_senha@rabbitmq:5672/

# JWT (openssl rand -base64 48)
JWT_SECRET=troque_por_um_segredo_aleatorio_longo

# E-mail: false só registra o e-mail no log, sem enviar
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true
MAIL_ENABLED=false
MAIL_FROM=no-reply@investai.com

# Fontes de mercado (mesmos valores do seu .env local)
HG_BRASIL_API_KEY=sua_chave_aqui
HG_BRASIL_BASE_URL=https://api.hgbrasil.com
HGBRASIL_MOCK_ENABLED=false
TESOURO_DIRETO_BASE_URL=https://brapi.dev/api/v2/treasury
TESOURO_DIRETO_MOCK_ENABLED=false
TESOURO_DIRETO_SYNC_CRON="0 0,30 10-18 * * MON-FRI"
BCB_BASE_URL=https://api.bcb.gov.br
MERCADO_SYNC_CRON="0 */15 10-18 * * MON-FRI"
SELIC_IPCA_SYNC_CRON="0 0 7 * * *"

# Integração com o microsserviço de IA
IA_TIMEOUT_SEGUNDOS=20
IA_HEALTH_BASE_URL=http://ia-service:8000
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=sua_chave_groq_aqui
ENABLE_PREVIEW_ENDPOINTS=false
