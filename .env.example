# ==============================================================================
# InvestAI — Variáveis de Ambiente
# Copie esse arquivo para `.env` (mesma pasta) e preencha os valores reais.
# O .env nunca é commitado (já está no .gitignore).
# ==============================================================================

# ------------------------------------------------------------------------------
# PostgreSQL
# ------------------------------------------------------------------------------
POSTGRES_DB=investai
POSTGRES_USER=investai
POSTGRES_PASSWORD=troque_essa_senha

# String de conexão usada pelo Spring Boot (InvestAI-API).
# Se estiver rodando via docker-compose, o host é o nome do serviço (ex: "postgres"),
# não "localhost" — os containers se enxergam pelo nome do serviço na mesma rede.
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/investai
SPRING_DATASOURCE_USERNAME=investai
SPRING_DATASOURCE_PASSWORD=troque_essa_senha

# ------------------------------------------------------------------------------
# RabbitMQ
# ------------------------------------------------------------------------------
SPRING_RABBITMQ_HOST=rabbitmq
SPRING_RABBITMQ_USERNAME=guest
SPRING_RABBITMQ_PASSWORD=guest

# Usado pelo microsserviço Python (InvestAI-IA) — mesma instância de RabbitMQ,
# formato de URL diferente porque é a lib pika, não Spring AMQP.
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/

# ------------------------------------------------------------------------------
# Auth (JWT)
# ------------------------------------------------------------------------------
# Segredo usado pra assinar os tokens — gere um valor aleatório longo (256 bits+)
# pra produção, nunca reaproveite o valor de exemplo do application-local.yml.
JWT_SECRET=troque_por_um_segredo_aleatorio_longo

# Duração do access token e do refresh token são fixas no application.yml
# (expiration-ms: 900000 = 15min, refresh-expiration-days: 7) — não são
# configuráveis por variável de ambiente hoje, só o segredo é externalizado.

# ------------------------------------------------------------------------------
# E-mail (SMTP) — recuperação de senha
# ------------------------------------------------------------------------------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=seu_email@gmail.com
MAIL_PASSWORD=sua_senha_de_app
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true
# false = loga o e-mail no console em vez de enviar de verdade (útil pra dev local)
MAIL_ENABLED=true
MAIL_FROM=no-reply@investai.com

# URL do frontend, usada para montar o link de redefinição de senha no e-mail
FRONTEND_URL=http://localhost:4200

# ------------------------------------------------------------------------------
# HG Brasil (cotação de ações + indicadores de mercado: Ibovespa/Dólar/Euro)
# ------------------------------------------------------------------------------
HG_BRASIL_API_KEY=sua_chave_aqui
HG_BRASIL_BASE_URL=https://api.hgbrasil.com
# true = usa dados sintéticos fixos, sem chamar a API de verdade (útil pra dev sem gastar cota)
HGBRASIL_MOCK_ENABLED=true

# ------------------------------------------------------------------------------
# Tesouro Direto (via brapi.dev — a API oficial está bloqueada por Cloudflare)
# ------------------------------------------------------------------------------
TESOURO_DIRETO_BASE_URL=https://brapi.dev/api/v2/treasury
# true = usa 7 títulos 100% sintéticos, sem chamar a brapi.dev
TESOURO_DIRETO_MOCK_ENABLED=true
# Cron do job de sincronização: a cada 30min, horário comercial, dias úteis
TESOURO_DIRETO_SYNC_CRON="0 0,30 10-18 * * MON-FRI"

# ------------------------------------------------------------------------------
# Banco Central (Selic + IPCA — API SGS/OLINDA, gratuita, sem chave)
# ------------------------------------------------------------------------------
BCB_BASE_URL=https://api.bcb.gov.br
MERCADO_SYNC_CRON="0 */15 10-18 * * MON-FRI"
SELIC_IPCA_SYNC_CRON="0 0 7 * * *"

# ------------------------------------------------------------------------------
# Comunicação Java <-> Microsserviço IA (Python)
# ------------------------------------------------------------------------------
# Timeout (segundos) que o Java espera pela resposta do ranqueamento via RabbitMQ
IA_TIMEOUT_SEGUNDOS=20
# URL do endpoint /health do Python, usada pelo GET /dashboard/admin
IA_HEALTH_BASE_URL=http://ia-service:8000

# ------------------------------------------------------------------------------
# Microsserviço IA (InvestAI-IA) — LLM
# ------------------------------------------------------------------------------
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=sua_chave_groq_aqui

# true = habilita os endpoints /ranking/preview e equivalentes (só pra dev/teste manual,
# desabilitar em produção)
ENABLE_PREVIEW_ENDPOINTS=false

# ⚠️ Presente no .env do InvestAI-IA mas nunca vi ser lida em nenhum código que passei
# essa sessão (sem uso confirmado ainda) — deixo documentada porque existe, mas não
# sei te dizer pra que serve.
NEWS_API_KEY=